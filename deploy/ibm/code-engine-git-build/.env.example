# IBM Code Engine BUILD-FROM-GIT deployment configuration for your MCP server.
#
# Copy to .env and fill in, then:
#   set -a; source deploy/ibm/code-engine-git-build/.env; set +a
# before running the scripts.
#
# This file contains NO secrets — only non-sensitive deployment coordinates.
# Your IBM Cloud API key is NEVER stored here (see IBMCLOUD_API_KEY note below).
#
# What this kit does (vs. the sibling prebuilt-image kit):
#   Code Engine clones GIT_REPO_URL, builds its Dockerfile SERVER-SIDE, pushes
#   the resulting image to YOUR IBM Container Registry (ICR) namespace, then
#   deploys it. No local Docker. This is the intended "point Code Engine at your
#   repo and go" flow — it requires ICR authority (namespace create/write + a
#   registry access secret).

# --- IBM Cloud target ---------------------------------------------------------
# Region for the Code Engine project. Common: us-south, us-east, eu-de, eu-gb.
IBMCLOUD_REGION=us-east

# Resource group. ALWAYS confirm with `ibmcloud resource groups` — many accounts
# have NO "Default" group and expose a single generated group like `eid-<hash>`.
IBMCLOUD_RESOURCE_GROUP=Default

# --- Code Engine app ----------------------------------------------------------
CE_PROJECT=mcp-hackathon
CE_APP_NAME=example-mcp-server
# Port the container listens on (template Dockerfile sets PORT=8080).
CE_PORT=8080

# --- Git source (build-from-Git) ---------------------------------------------
# Public repo Code Engine will clone and build. Public repos only.
#   GIT_REPO_URL=https://github.com/<you>/<your-mcp-server>
GIT_REPO_URL=
GIT_BRANCH=main
GIT_CONTEXT_DIR=.
GIT_DOCKERFILE=Dockerfile

# --- IBM Container Registry (build output target) ----------------------------
# Confirm your account's registry with `ibmcloud cr region` (shows the currently
# targeted one) — NOT `ibmcloud cr regions`, which does not exist.
#
#   global   -> icr.io      (default in many TechZone / itz-saas-* accounts)
#   us-south -> us.icr.io
#   eu-de    -> de.icr.io
#   eu-gb    -> uk.icr.io
#
# NOTE: the ICR region is independent of IBMCLOUD_REGION. A Code Engine app in
# us-east can push to the GLOBAL registry (icr.io) — a valid, common pairing.
ICR_REGION=global
ICR_DOMAIN=icr.io

# Namespace within ICR to push the built image into. The deploy script creates
# it if missing, but namespace-CREATE requires authority some trial accounts
# withhold. FIRST run `ibmcloud cr namespace-list`: if a shared namespace was
# pre-provisioned for you, set this to that name and reuse it.
ICR_NAMESPACE=mcp-hackathon

# Tag applied to the built image. Full reference:
#   ${ICR_DOMAIN}/${ICR_NAMESPACE}/${CE_APP_NAME}:${IMAGE_TAG}
IMAGE_TAG=latest

# Name of the Code Engine registry-access secret the script creates/uses so CE
# can push the built image to ICR. This is a CE object name, not a credential.
CE_REGISTRY_SECRET=icr-push-secret

# --- IBM Cloud API key (NOT stored in this file) -----------------------------
# The registry-access secret is created from an IBM Cloud IAM API key. Provide
# it at runtime via IBMCLOUD_API_KEY (NOT committed):
#
#   export IBMCLOUD_API_KEY="$(ibmcloud iam api-key-create ce-icr-push \
#       -d 'Code Engine ICR push' --output json | jq -r .apikey)"
#
# If IBMCLOUD_API_KEY is unset, the deploy script prompts for it (input hidden)
# and never writes it to disk. Rotate/delete when finished:
#   ibmcloud iam api-key-delete ce-icr-push
