# IBM Cloud Code Engine deployment configuration for your MCP server.
#
# Copy to .env and fill in, then: `set -a; source deploy/ibm/prebuilt-image/.env; set +a`
# before running the scripts (the `set -a` exports the vars for the script).
#
# This file contains NO secrets — only non-sensitive deployment coordinates.
# (Your IBM Cloud API key is handled by `ibmcloud login`, not stored here.)
#
# This kit deploys a PREBUILT IMAGE from a public container registry (e.g.
# ghcr.io). It does not build from source or push to IBM Container Registry.
# To build from a Git repo and push to ICR, use ../code-engine-git-build/.

# --- IBM Cloud target ---------------------------------------------------------
# Region for the Code Engine project. Common: us-south, us-east, eu-de, eu-gb.
IBMCLOUD_REGION=us-south

# Resource group the project lives in. Run `ibmcloud resource groups` to confirm
# what you have access to — many accounts have NO "Default" group and expose a
# single generated group like `eid-<hash>`.
IBMCLOUD_RESOURCE_GROUP=Default

# --- Code Engine app ----------------------------------------------------------
# Code Engine project name (created if it does not exist).
CE_PROJECT=mcp-hackathon

# Name of the Code Engine application (use your own server's name).
CE_APP_NAME=example-mcp-server

# Port the container listens on. This template's Dockerfile sets PORT=8080 and
# serves MCP (streamable-HTTP) at /mcp with a health check at /health.
CE_PORT=8080

# --- Prebuilt public image ----------------------------------------------------
# Full image reference from a public registry. Code Engine pulls this directly —
# no local Docker, no IBM Container Registry authority required.
#
# Examples:
#   ghcr.io/<github-user>/<repo>:0.1.0
#   docker.io/<dockerhub-user>/<repo>:latest
#
# To publish a GitHub-hosted image to GHCR, see:
#   https://docs.github.com/en/packages/working-with-a-github-packages-registry/working-with-the-container-registry
#
IMAGE=
