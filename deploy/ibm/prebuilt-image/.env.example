# IBM Cloud Code Engine deployment configuration for your MCP server.
#
# Copy to .env and fill in, then: `set -a; source deploy/ibm/prebuilt-image/.env; set +a`
# before running the scripts (the `set -a` exports the vars for the script).
#
# This file contains NO secrets — only non-sensitive deployment coordinates.
# (Your IBM Cloud API key is handled by `ibmcloud login`, not stored here.)

# --- IBM Cloud target ---------------------------------------------------------
# Region for the Code Engine project. Common: us-south, us-east, eu-de, eu-gb.
IBMCLOUD_REGION=us-south

# Resource group the project lives in. Run `ibmcloud resource groups` to confirm
# what you have access to — many accounts have NO "Default" group and expose a
# single generated group like `eid-<hash>`.
IBMCLOUD_RESOURCE_GROUP=Default

# --- Code Engine app ----------------------------------------------------------
# Code Engine project name (created if it does not exist).
CE_PROJECT=mcp-hackathon

# Name of the Code Engine application (use your own server's name).
CE_APP_NAME=example-mcp-server

# Port the container listens on. This template's Dockerfile sets PORT=8080 and
# serves MCP (streamable-HTTP) at /mcp with a health check at /health.
CE_PORT=8080

# =============================================================================
# DEPLOY SOURCE — choose ONE of the two paths below.
# =============================================================================

# --- Path A (DEFAULT): build from a public Git repo, server-side -------------
# Code Engine clones the repo and builds it FOR you — no local Docker, no
# registry, no push. Point these at YOUR public fork of the template.
#
# Public repos only (hackathon scope is public data). Private repos would need a
# Code Engine Git secret; out of scope here.
#
#   GIT_REPO_URL=https://github.com/<you>/<your-mcp-server>
#   GIT_BRANCH=main
GIT_REPO_URL=
GIT_BRANCH=main

# Subdirectory within the repo that contains the Dockerfile (build context).
# "." means the repo root. Change if your server lives in a subfolder.
GIT_CONTEXT_DIR=.

# Path to the Dockerfile, relative to GIT_CONTEXT_DIR.
GIT_DOCKERFILE=Dockerfile

# --- Path B (OVERRIDE): deploy a prebuilt public image -----------------------
# If IMAGE is set (non-empty), the deploy script IGNORES the Git vars above and
# deploys this prebuilt image directly. Use for a pinned, reproducible release.
# Leave EMPTY to use the Git build path above.
#   IMAGE=ghcr.io/<you>/<your-mcp-server>:0.1.0
IMAGE=
